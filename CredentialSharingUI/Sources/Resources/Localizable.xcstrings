    },
    "bluetoothDeniedParagraph2" : {
      "extractionState" : "manual",
      "localizations" : {
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni fyddwch yn cysylltu â dyfais ar hyn o bryd."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will not connect with a device yet."
          }
        }
      }
    },
    "bluetoothDeniedStep1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ewch i osodiadau eich ffôn ar gyfer yr ap hwn a rhoi Bluetooth ymlaen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to your phone settings for this app and toggle Bluetooth on."
