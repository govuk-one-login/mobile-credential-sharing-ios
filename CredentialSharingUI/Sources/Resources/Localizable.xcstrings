      "extractionState" : "manual",
      "localizations" : {
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cadw eich manylion ond cyhyd ag y mae angen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "keep your details only as long as they need to"
