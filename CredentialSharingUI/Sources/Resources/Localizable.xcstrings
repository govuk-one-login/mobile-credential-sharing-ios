    "sharingCardNoneKeptSentence": {
      "comment": "None-kept variant sentence.",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim ond ar gyfer y gwiriad hwn y defnyddir y manylion hyn. Ni fyddant yn cael eu harbed."
