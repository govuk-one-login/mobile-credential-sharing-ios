    },
    "turnOnBluetoothParagraph1": {
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyn y gallwch rannu, mae angen i chi droi Bluetooth ymlaen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you can share, you need to turn on Bluetooth."
          }
        }
      }
    },
    "turnOnBluetoothParagraph2": {
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni fyddwch yn cysylltu â dyfais ar hyn o bryd. Byddwch yn defnyddio cod QR i wneud hynny nesaf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will not connect with a device yet. You’ll use a QR code to do that next."
          }
        }
      }
    },
    "turnOnBluetoothStep1": {
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yng ngosodiadau ffôn, ewch i Bluetooth a gwnewch yn siŵr ei fod ymlaen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your phone settings, go to Bluetooth and make sure it is on."
          }
        }
      }
    },
