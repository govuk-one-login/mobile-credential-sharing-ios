    "bluetoothDeniedParagraph1" : {
      "extractionState" : "manual",
      "localizations" : {
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er mwyn gallu rhannu, mae angen i chi ganiatáu i'r ap hwn i ddefnyddio Bluetooth."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To be able to share, you need to allow this app to use Bluetooth."
