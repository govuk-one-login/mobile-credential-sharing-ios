    "detailsSharedBody": {
      "extractionState": "migrated",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd y person yn gwirio'r manylion rydych wedi'u rhannu.\n\nBydd eich cysylltiad Bluetooth gyda hwy nawr yn dod i ben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The person will check the details you shared.\n\nYour Bluetooth connection with them will now end."
          }
        }
      }
    },
    "detailsSharedTitle": {
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Manylion wedi'u rhannu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details shared"
          }
        }
      }
    },
    "getReadyToShareAllowBluetoothButton": {
      "extractionState": "migrated",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Caniatáu Bluetooth"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Bluetooth"
          }
        }
      }
    },
    "getReadyToShareBodyParagraph1": {
      "extractionState": "migrated",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyn y gallwch rannu manylion o'ch trwydded yrru’r DU, mae angen i chi ganiatáu i'r ap hwn ddefnyddio Bluetooth."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you can share details from your UK driving licence, you need to allow this app to use Bluetooth."
          }
        }
      }
    },
    "getReadyToShareBodyParagraph2": {
      "extractionState": "migrated",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Os yw Bluetooth wedi'i ddiffodd ar eich ffôn, bydd angen i chi ei droi ymlaen hefyd."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Bluetooth is turned off on your phone, you’ll need to turn it on too."
          }
        }
      }
    },
    "getReadyToShareBodyParagraph3": {
      "extractionState": "migrated",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni fyddwch yn cysylltu â dyfais ar hyn o bryd. Byddwch yn defnyddio cod QR i wneud hynny yn nes ymlaen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will not connect with a device yet. You’ll use a QR code to do that later."
          }
        }
      }
    },
    "getReadyToShareFindOutHowButton": {
      "extractionState": "migrated",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Darganfyddwch sut mae rhannu yn gweithio"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find out how sharing works"
          }
        }
      }
    },
    "getReadyToShareTitle": {
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Paratoi i rannu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get ready to share"
          }
        }
      }
    },
    "mdlDocumentName": {
      "comment": "Display name for the mobile driving licence document.",
      "extractionState": "stale",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "drwydded yrru'r DU"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UK driving licence"
          }
        }
      }
    },
    "sharingCardHeader": {
      "comment": "Sharing card header, singular (exactly 1 detail). %1$@ is the number of attributes, %2$@ is the document name.",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Byddwch yn rhannu %1$@ manylyn o'ch %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll share %1$@ detail from your %2$@"
          }
        }
      }
    },
    "sharingCardHeaderPlural": {
      "comment": "Sharing card header, plural (2 or more details). %1$@ is the number of attributes, %2$@ is the document name.",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Byddwch yn rhannu manylion %1$@ o'ch %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll share %1$@ details from your %2$@"
          }
        }
      }
    },
    "sharingCardKeptLeadIn": {
      "comment": "Lead-in above the list of details the verifier will keep. %1$@ is the verifier (DVS) name.",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Bydd %1$@ yn cadw'r manylion hyn fel cofnod o'r gwiriad hwn:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will keep these details as a record of this check:"
          }
        }
      }
    },
    "sharingCardNotKeptLeadIn": {
      "comment": "Lead-in above the list of details the verifier will not keep. %1$@ is the verifier (DVS) name.",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni fydd %1$@ yn cadw:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will not keep:"
          }
        }
      }
    },
    "sharingCardKeptAllSentence": {
      "comment": "Sentence shown when the verifier keeps all shared details. %1$@ is the verifier (DVS) name.",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bydd %1$@ yn cadw'r holl fanylion hyn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will keep all of these details."
          }
        }
      }
    },
    "sharingCardNoneKeptSentence": {
      "comment": "Sentence shown when the verifier keeps none of the shared details.",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ni fydd unrhyw rai o'r manylion hyn yn cael eu cadw."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of these details will be kept."
          }
        }
      }
    },
    "turnOnBluetoothListTitle": {
      "extractionState": "manual",
      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "I wneud hyn:"
          }
