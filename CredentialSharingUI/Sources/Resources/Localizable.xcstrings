    "requiredCertificationList3" : {
      "extractionState" : "manual",
      "localizations" : {
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "peidio byth â defnyddio'ch manylion at ddibenion marchnata"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "never use your details for marketing purposes"
          }
        }
      }
    },
    "requiredCertificationListTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae %(variableName)@ wedi'i ardystio o dan Fframwaith Ymddiriedaeth Gwasanaethau Gwirio Digidol y DU. Mae hyn yn golygu bod yn rhaid iddynt:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(variableName)@ is certified under the UK Digital Verification Services Trust Framework. This means they must:"
          }
        }
      }
    }
