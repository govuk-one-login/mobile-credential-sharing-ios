      "localizations": {
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gwelwch yr opsiwn i Allow New Connections, tapiwch ef."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you see the option to Allow New Connections, tap it."
