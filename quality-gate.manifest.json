{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.18.0/schemas/schema.json",
  "services": [
    {
      "product": "iOS-Mobile-Credential-Sharing",
      "component": "mobile-credential-sharing-ios",
      "promotionType": "other",
      "promotionTypeDetails": [
        "deploys library to a build account"
      ],
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/pull-request.yml",
          "path": "$.jobs.validate_lint.steps[?@.name=='Run Linter']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/pull-request.yml",
          "path": "$.jobs.build.steps[?@.name=='Build']"
        },
        {
          "phase": "build",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/quality-report.yml",
          "path": "$.jobs.build"
        }
      ]
    }
  ]
}
